build/*.msi
build/*.blockmap
build/*.yml
*.appx
*.appxbundle

# Logs and caches
*.log
logs/
.cache/
.eslintcache
*.tsbuildinfo
coverage/

# Environment and secrets
.env
.env.*
!.env.example

# OS and editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

