{
  "name": "manga-lab-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop reader that translates raw manga, manhwa and webtoons to Simplified Chinese.",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Contributors",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "vitest run",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.mjs --win --dir",
    "dist": "npm run build && electron-builder --config electron-builder.config.mjs --win"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-store": "12.0.0",
    "onnxruntime-node": "1.31.1",
    "p-queue": "10.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
